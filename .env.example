# =============================================================================
# Printswipe — environment variables
# Copy this file to .env.local and fill in real values for local dev.
# For Vercel: paste each non-comment line into Project Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  (Project → Settings → API)
# Region: Mumbai / ap-south-1 for IST latency
# -----------------------------------------------------------------------------
# Used by both server (createServerClient) and browser (createBrowserClient)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only mirrors (read by /lib/supabase/admin.ts and the seed script)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — NEVER expose to the browser. Used by:
#   - scripts/seed.ts
#   - /api/payment/verify (token issuance)
#   - /api/merchant/bundle (file downloads from private storage)
#   - /auth/callback (campus matching + profile upsert)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# Google OAuth (configured in Supabase Auth → Providers → Google)
# No env vars live here — Supabase stores Client ID + Secret server-side.
# Setup steps:
#   1. Google Cloud → Credentials → OAuth Client ID (Web application)
#      Authorized redirect URIs: https://YOUR-PROJECT-REF.supabase.co/auth/v1/callback
#   2. Supabase → Auth → Providers → Google → enable + paste Client ID/Secret
#   3. Supabase → Auth → URL Configuration:
#        Site URL: https://printswipe.in
#        Redirect URLs: https://printswipe.in/auth/callback,
#                       https://www.printswipe.in/auth/callback,
#                       http://localhost:3000/auth/callback
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Razorpay  (Dashboard → Settings → API Keys)
# Test keys start `rzp_test_...`; live keys `rzp_live_...` after KYC.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public-side key for the checkout.js modal — same value as RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Webhook secret — set this string in Razorpay Dashboard → Webhooks → Secret
# Webhook URL to register: https://printswipe.in/api/payment/webhook
# Active events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=any-strong-random-string-32-chars-min

# -----------------------------------------------------------------------------
# Twilio SMS (optional — feature-flagged)
# Leave FEATURE_SMS_ENABLED=false unless you've completed Twilio + DLT setup.
# -----------------------------------------------------------------------------
FEATURE_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+91XXXXXXXXXX

# -----------------------------------------------------------------------------
# App identity
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Printswipe
NEXT_PUBLIC_APP_DOMAIN=printswipe.in
NEXT_PUBLIC_APP_URL=https://printswipe.in

# -----------------------------------------------------------------------------
# PWA (next-pwa@5.6.0 has incompat with Next 14.2 + pnpm hoisting on Vercel)
# Set to "true" only after migrating to @serwist/next.
# -----------------------------------------------------------------------------
PWA_ENABLED=false
